# Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# n8n
N8N_BASE_URL=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_SECRET=

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini AI (optional primary/fallback provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Application
APP_BASE_URL=http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:5678
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR
APP_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Calendar OAuth (required for automatic Google Meet interviews)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
INTERVIEW_REMINDER_MINUTES=30
INTERVIEW_DAY_REMINDER_HOURS=24

# Optional email integration; simulated email logging is the default
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_ENABLED=false

# Authentication and abuse protection
OTP_PEPPER=replace-with-a-long-random-secret
OTP_EXPIRY_MINUTES=10
EXPOSE_TEST_OTP=false
SHARED_STAFF_LOGIN_ENABLED=false
SESSION_COOKIE_NAME=novatech_session
REFRESH_COOKIE_NAME=novatech_refresh
CSRF_COOKIE_NAME=novatech_csrf
PERSONA_COOKIE_NAME=novatech_persona
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Initial staff accounts (use only while running the provisioning script)
INITIAL_ADMIN_NAME=NovaTech Administrator
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_HR_NAME=HR Manager
INITIAL_HR_USERNAME=
INITIAL_HR_EMAIL=
INITIAL_HR_PASSWORD=
INITIAL_RECRUITER_NAME=Recruiter
INITIAL_RECRUITER_USERNAME=
INITIAL_RECRUITER_EMAIL=
INITIAL_RECRUITER_PASSWORD=
INITIAL_INTERVIEWER_NAME=Interviewer
INITIAL_INTERVIEWER_USERNAME=
INITIAL_INTERVIEWER_EMAIL=
INITIAL_INTERVIEWER_PASSWORD=
