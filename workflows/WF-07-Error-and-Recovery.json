            }
          ]
        }
      },
      "id": "7a018a2f-80e0-4529-8ab0-708bd927dcee",
      "name": "Resolve Replayed Error",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1040,
        704
      ],
      "credentials": {
        "supabaseApi": {
          "id": "nycOZgSYcd2BLIzl",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const request = $('Validate and Route Replay').first().json;\nconst replay = $('Replay Through Safe Webhook').first().json;\nreturn [{ json: { success: true, error_id: request.error_id, target_key: request.target_key, queue_status: 'RESOLVED', display_status: 'Error Replayed Successfully', admin_message: 'The corrected payload was replayed through an approved workflow endpoint.', replay_result: replay } }];"
      },
      "id": "099f579f-b239-48ae-8ba1-1cb472815403",
      "name": "Prepare Replay Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
