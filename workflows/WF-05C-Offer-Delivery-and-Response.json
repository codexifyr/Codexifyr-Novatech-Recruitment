    {
      "parameters": {
        "jsCode": "const request = $('Validate Candidate Response').first().json;\nconst offer = $('Load Offered Offer').first().json;\nconst accepted = request.candidate_response === 'ACCEPTED';\nreturn [{ json: { success: true, offer_id: offer.id, offer_code: offer.offer_code, application_id: offer.application_id, candidate_response: request.candidate_response, offer_status: request.candidate_response, application_status: request.candidate_response, display_status: accepted ? 'Offer Accepted' : request.candidate_response === 'DECLINED' ? 'Offer Declined' : 'Offer Negotiation Requested', message: accepted ? 'Your offer acceptance has been recorded successfully.' : request.candidate_response === 'DECLINED' ? 'Your offer decision has been recorded.' : 'Your negotiation request has been sent to the hiring team.', next_workflow: accepted ? 'WF-06 - Employee Onboarding' : request.candidate_response === 'NEGOTIATION' ? 'ADMIN_REVIEW' : 'PROCESS_END' } }];"
      },
