    {
      "parameters": {
        "jsCode": "const application = $json;\nconst offer = $('Load Approved Offer').first().json;\nconst request = $('Validate Delivery Request').first().json;\nconst portalUrl = `${request.candidate_portal_base_url}/offer-response?offer_id=${encodeURIComponent(offer.id)}`;\nconst message = `Hello ${application.name_at_application},\n\nCongratulations! NovaTech Solutions has approved your employment offer.\n\nOffer code: ${offer.offer_code}\nSalary: ${offer.currency} ${offer.salary}\nJoining date: ${offer.joining_date}\nProbation: ${offer.probation_months} month(s)\nOffer expiry: ${offer.expiry_date}\n\nReview and respond through the candidate portal:\n${portalUrl}\n\nRegards,\nNovaTech Solutions Recruitment Team`;\nreturn [{ json: { offer_id: offer.id, offer_code: offer.offer_code, application_id: offer.application_id, candidate_id: application.candidate_id, candidate_name: application.name_at_application, candidate_email: application.email_at_application, salary: offer.salary, currency: offer.currency, joining_date: offer.joining_date, expiry_date: offer.expiry_date, email_to: application.email_at_application, email_subject: `Employment Offer - ${offer.offer_code}`, email_message: message, portal_url: portalUrl, sent_at: new Date().toISOString() } }];"
      },
