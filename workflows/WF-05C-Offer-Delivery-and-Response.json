    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst offerId = String(body.offer_id || '').trim();\nconst response = String(body.response || '').trim().toUpperCase();\nconst notes = String(body.notes || '').trim();\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst errors = [];\nif (!uuidPattern.test(offerId)) errors.push('A valid offer_id is required');\nif (!['ACCEPTED', 'DECLINED', 'NEGOTIATION'].includes(response)) errors.push('response must be ACCEPTED, DECLINED, or NEGOTIATION');\nif (response === 'NEGOTIATION' && !notes) errors.push('notes are required for negotiation');\nreturn [{ json: { offer_id: offerId, candidate_response: response, response_notes: notes || null, candidate_responded_at: new Date().toISOString(), request_valid: errors.length === 0, validation_errors: errors } }];"
      },
