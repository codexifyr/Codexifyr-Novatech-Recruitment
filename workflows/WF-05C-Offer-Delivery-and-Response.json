    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst offerId = String(body.offer_id || '').trim();\n\nconst uuidPattern =\n  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\n\nconst errors = [];\n\nif (!uuidPattern.test(offerId)) {\n  errors.push('A valid offer_id is required');\n}\n\nconst rawPortalUrl = String(\n  body.candidate_portal_base_url || 'http://localhost:3000'\n);\n\nconst portalBaseUrl = rawPortalUrl.endsWith('/')\n  ? rawPortalUrl.slice(0, -1)\n  : rawPortalUrl;\n\nreturn [{\n  json: {\n    offer_id: offerId,\n    candidate_portal_base_url: portalBaseUrl,\n    request_valid: errors.length === 0,\n    validation_errors: errors\n  }\n}];"
      },
