    {
      "parameters": {
        "jsCode": "const tasks = $input.all().map(item => item.json);\nconst employee = $('Load Task Employee').first().json;\nconst completedCount = tasks.filter(task => task.status === 'COMPLETED').length;\nreturn [{ json: { employee_id: employee.id, employee_code: employee.employee_code, application_id: employee.application_id, task_count: tasks.length, completed_count: completedCount, remaining_count: tasks.length - completedCount, all_complete: tasks.length > 0 && tasks.every(task => task.status === 'COMPLETED') } }];"
      },
      "id": "325d2720-bdff-4594-9032-52c63bf89ff4",
      "name": "Evaluate Onboarding Completion",
      "type": "n8n-nodes-base.code",
