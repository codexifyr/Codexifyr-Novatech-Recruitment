    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().slice(0, 10);\nreturn $input.all().filter(item => ['PENDING', 'IN_PROGRESS'].includes(item.json.status) && item.json.due_date < today).map(item => ({ json: { ...item.json, overdue_checked_at: new Date().toISOString() } }));"
      },
      "id": "d5f15545-df96-4a5d-a53f-fe3a1acca276",
      "name": "Select Overdue Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1664,
        592
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "onboarding_tasks",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
