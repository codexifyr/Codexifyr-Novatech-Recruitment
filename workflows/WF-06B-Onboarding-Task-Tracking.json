      "credentials": {
        "supabaseApi": {
          "id": "nycOZgSYcd2BLIzl",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "f60b0000-0000-4a00-8000-000000000005",
              "leftValue": "={{ ['PENDING', 'IN_PROGRESS', 'OVERDUE'].includes($json.status) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
