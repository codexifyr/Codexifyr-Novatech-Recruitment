    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst taskId = String(body.task_id || '').trim();\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst errors = [];\nif (!uuidPattern.test(taskId)) errors.push('A valid task_id is required');\nreturn [{ json: { task_id: taskId, request_valid: errors.length === 0, validation_errors: errors, completed_at: new Date().toISOString() } }];"
      },
      "id": "2bf5c6c6-9fd7-4988-858b-f63d136a3525",
      "name": "Validate Task Completion",
      "type": "n8n-nodes-base.code",
