    {
      "parameters": {
        "jsCode": "const summary = $('Evaluate Onboarding Completion').first().json;\nreturn [{ json: { success: true, task_completed: true, employee_id: summary.employee_id, employee_code: summary.employee_code, completed_tasks: summary.completed_count, remaining_tasks: summary.remaining_count, employee_status: 'COMPLETED', application_status: 'ONBOARDED', display_status: 'Onboarding Completed', message: 'All onboarding tasks are complete.' } }];"
      },
      "id": "4736cbbd-6c68-4e64-b666-39782e52da7f",
      "name": "Prepare Onboarding Complete Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { success: true, task_completed: true, employee_id: $json.employee_id, employee_code: $json.employee_code, completed_tasks: $json.completed_count, remaining_tasks: $json.remaining_count, employee_status: 'ONBOARDING', application_status: 'ONBOARDING', display_status: 'Onboarding In Progress', message: `${$json.remaining_count} onboarding task(s) remain.` } }];"
      },
      "id": "3293ad57-1e8f-4051-b441-0a7d6f8bf4de",
      "name": "Prepare Task Completion Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const task = $json;\nreturn [{ json: { success: task.status === 'COMPLETED', idempotent_result: task.status === 'COMPLETED', task_id: task.id || $('Validate Task Completion').first().json.task_id, task_status: task.status || 'NOT_FOUND', display_status: task.status === 'COMPLETED' ? 'Task Already Completed' : 'Task Completion Blocked', message: task.status === 'COMPLETED' ? 'This onboarding task was already completed.' : 'The onboarding task was not found or cannot be completed.' } }];"
      },
      "id": "cb4043a8-a43a-4dc5-93f5-a548d4e33157",
      "name": "Prepare Task Blocked Result",
