        "tableId": "onboarding_tasks",
        "limit": 1,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.task_id }}"
            }
          ]
        }
      },
      "id": "08f006b4-2dec-4a3c-a76e-7575d9376cc0",
      "name": "Load Onboarding Task",
