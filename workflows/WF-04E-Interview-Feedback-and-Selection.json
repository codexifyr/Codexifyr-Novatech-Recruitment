    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst interviewId = String(body.interview_id || '').trim();\nconst submittedBy = body.submitted_by ? String(body.submitted_by).trim() : null;\nconst recommendation = String(body.recommendation || '').trim().toUpperCase();\nconst scores = { technical_score: Number(body.technical_score), communication_score: Number(body.communication_score), problem_solving_score: Number(body.problem_solving_score), experience_score: Number(body.experience_score), team_fit_score: Number(body.team_fit_score) };\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst errors = [];\nif (!uuidPattern.test(interviewId)) errors.push('A valid interview_id is required');\nif (submittedBy && !uuidPattern.test(submittedBy)) errors.push('submitted_by must be a valid UUID');\nfor (const [field, value] of Object.entries(scores)) if (!Number.isInteger(value) || value < 1 || value > 10) errors.push(`${field} must be an integer between 1 and 10`);\nif (!['SELECT', 'REJECT', 'REVIEW'].includes(recommendation)) errors.push('recommendation must be SELECT, REJECT, or REVIEW');\nreturn [{ json: { interview_id: interviewId, submitted_by: submittedBy, recommendation, comments: String(body.comments || '').trim() || null, ...scores, submitted_at: new Date().toISOString(), request_valid: errors.length === 0, validation_errors: errors } }];"
      },
