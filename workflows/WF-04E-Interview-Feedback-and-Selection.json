    {
      "parameters": {
        "jsCode": "const f = $('Validate Interview Feedback').first().json;\nconst interview = $('Load Feedback Interview').first().json;\nconst application = $('Load Interview Application').first().json;\nconst interviewAverage = (f.technical_score + f.communication_score + f.problem_solving_score + f.experience_score + f.team_fit_score) / 5;\nconst interviewScore = Math.round(interviewAverage * 10 * 100) / 100;\nconst ruleScore = Number(application.final_score ?? application.rule_score ?? 0);\nconst combinedScore = Math.round((ruleScore * 0.4 + interviewScore * 0.6) * 100) / 100;\nlet decision = 'MANUAL_REVIEW';\nlet reason = `Interview recommendation ${f.recommendation}; combined score ${combinedScore}`;\nif (f.recommendation === 'SELECT' && combinedScore >= 75) { decision = 'SELECTED'; reason = `Selected after interview; combined score ${combinedScore}`; }\nelse if (f.recommendation === 'REJECT' && combinedScore < 75) { decision = 'REJECTED'; reason = `Rejected after interview; combined score ${combinedScore}`; }\nreturn [{ json: { ...f, application_id: interview.application_id, application_code: application.application_code, previous_status: application.status, interview_code: interview.interview_code, interview_average: interviewAverage, interview_score: interviewScore, rule_score: ruleScore, combined_score: combinedScore, selection_decision: decision, decision_reason: reason } }];"
      },
