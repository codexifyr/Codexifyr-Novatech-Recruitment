      "parameters": {
        "jsCode": "const result = $('Calculate Interview Decision').first().json;\nreturn [{ json: { success: true, feedback_created: true, interview_id: result.interview_id, interview_code: result.interview_code, application_id: result.application_id, application_code: result.application_code, interview_average: result.interview_average, interview_score: result.interview_score, rule_score: result.rule_score, combined_score: result.combined_score, recommendation: result.recommendation, application_status: result.selection_decision, display_status: result.selection_decision === 'SELECTED' ? 'Candidate Selected' : result.selection_decision === 'REJECTED' ? 'Candidate Rejected After Interview' : 'Candidate Requires Manual Review', admin_message: result.decision_reason, next_workflow: result.selection_decision === 'SELECTED' ? 'WF-05 - Offer Creation and Approval Setup' : result.selection_decision === 'MANUAL_REVIEW' ? 'ADMIN_REVIEW' : 'PROCESS_END' } }];"
      },
