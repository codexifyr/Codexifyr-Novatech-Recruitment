        "jsCode": "const request = $('Validate Confirmation Request').first().json;\nreturn [{ json: { success: false, interview_status: 'NOT_FOUND', display_status: 'Interview Not Found', message: 'The confirmation token is invalid or expired.', validation_errors: request.validation_errors || [] } }];"
      },
      "id": "f5f10241-3aae-4c0f-a6f5-df78b80d4e2d",
