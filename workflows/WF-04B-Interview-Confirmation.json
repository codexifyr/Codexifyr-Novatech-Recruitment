        "jsCode": "const body = $json.body || $json;\nconst token = String(body.confirmation_token || '').trim();\nconst action = String(body.action || 'CONFIRM').trim().toUpperCase();\nconst errors = [];\nif (!token) errors.push('confirmation_token is required');\nif (!['CONFIRM'].includes(action)) errors.push('Only CONFIRM is supported by this endpoint');\nreturn [{ json: { confirmation_token: token, action, request_valid: errors.length === 0, validation_errors: errors, received_at: new Date().toISOString() } }];"
      },
