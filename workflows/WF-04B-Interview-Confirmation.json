    {
      "parameters": {
        "jsCode": "const interview = $json;\nconst original = $('Find Interview by Token').first().json;\nreturn [{ json: { success: true, interview_id: interview.id || original.id, interview_code: interview.interview_code || original.interview_code, application_id: interview.application_id || original.application_id, scheduled_start: interview.scheduled_start || original.scheduled_start, scheduled_end: interview.scheduled_end || original.scheduled_end, meeting_url: interview.meeting_url || original.meeting_url, interview_status: 'CONFIRMED', display_status: 'Interview Confirmed', message: 'Your interview has been confirmed successfully.' } }];"
      },
