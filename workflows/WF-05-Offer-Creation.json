      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst applicationId = String(body.application_id || '').trim();\nconst salary = Number(body.salary ?? body.offer_salary);\nconst currency = String(body.currency || 'PKR').trim().toUpperCase();\nconst joiningDate = body.joining_date ? String(body.joining_date).slice(0, 10) : null;\nconst probationMonths = Number(body.probation_months ?? 3);\nconst reportingManagerId = body.reporting_manager_id ? String(body.reporting_manager_id).trim() : null;\nconst documentUrl = body.document_url ? String(body.document_url).trim() : null;\nconst errors = [];\nif (!applicationId) errors.push('application_id is required');\nif (!Number.isFinite(salary) || salary <= 0) errors.push('salary must be greater than zero');\nif (joiningDate && Number.isNaN(Date.parse(joiningDate))) errors.push('joining_date must be a valid date');\nif (!Number.isInteger(probationMonths) || probationMonths < 0 || probationMonths > 12) errors.push('probation_months must be between 0 and 12');\nreturn [{ json: { application_id: applicationId, salary, currency, joining_date: joiningDate, probation_months: probationMonths, reporting_manager_id: reportingManagerId, document_url: documentUrl, request_valid: errors.length === 0, validation_errors: errors, received_at: new Date().toISOString() } }];"
