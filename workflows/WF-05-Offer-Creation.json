      "parameters": {
        "jsCode": "const request = $('Validate Offer Request').first().json;\nconst application = $('Load Selected Application').first().json;\nconst now = new Date();\nconst suffix = `${Date.now()}${Math.random().toString(36).slice(2, 8)}`;\nconst expiry = new Date(now);\nexpiry.setUTCDate(expiry.getUTCDate() + 7);\nconst joiningDate = request.joining_date || application.joining_date;\nif (!joiningDate) throw new Error('joining_date is missing from both request and application');\nconst approvalLevels = request.salary > 300000 ? 2 : 1;\nreturn [{ json: { ...request, application_code: application.application_code, candidate_id: application.candidate_id, offer_code: `OFF-${now.getUTCFullYear()}-${suffix.slice(-10)}`, joining_date: joiningDate, expiry_date: expiry.toISOString().slice(0, 10), approval_required_levels: approvalLevels, offer_status: 'PENDING_APPROVAL' } }];"
