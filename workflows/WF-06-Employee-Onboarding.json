        "jsCode": "const employee = $('Attach Employee ID').first().json;\nconst taskCount = $input.all().length;\nreturn [{ json: { ...employee, task_count: taskCount, email_to: employee.candidate_email, email_subject: `Welcome to NovaTech Solutions - ${employee.employee_code}`, email_message: `Hello ${employee.candidate_name},\n\nWelcome to NovaTech Solutions! Your employee onboarding has started.\n\nEmployee code: ${employee.employee_code}\nDepartment: ${employee.department}\nStart date: ${employee.start_date}\nOnboarding tasks created: ${taskCount}\n\nPlease sign in to the candidate/employee portal to complete your assigned tasks.\n\nRegards,\nNovaTech Solutions HR Team` } }];"
