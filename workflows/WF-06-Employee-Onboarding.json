      "parameters": {
        "jsCode": "const offer = $('Load Accepted Offer').first().json;\nconst application = $('Load Accepted Application').first().json;\nconst position = $('Load Employee Department').first().json;\nconst suffix = `${Date.now()}${Math.random().toString(36).slice(2, 8)}`;\nreturn [{ json: { employee_code: `EMP-${new Date().getUTCFullYear()}-${suffix.slice(-8)}`, candidate_id: application.candidate_id, application_id: application.id, offer_id: offer.id, offer_code: offer.offer_code, candidate_name: application.name_at_application, candidate_email: application.email_at_application, department: position.department || 'General', manager_id: offer.reporting_manager_id || null, start_date: offer.joining_date, employee_status: 'ONBOARDING' } }];"
