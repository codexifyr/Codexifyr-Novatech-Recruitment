      "parameters": {
        "jsCode": "const employee = $json;\nconst source = $('Prepare Employee Record').first().json;\nreturn [{ json: { ...source, employee_id: employee.id, employee_code: employee.employee_code || source.employee_code, employee_status: employee.status || source.employee_status } }];"
