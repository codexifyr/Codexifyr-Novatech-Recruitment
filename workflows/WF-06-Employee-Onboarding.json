    {
      "parameters": {
        "jsCode": "const employee = $json;\nconst start = new Date(`${employee.start_date}T00:00:00.000Z`);\nconst due = days => { const d = new Date(start); d.setUTCDate(d.getUTCDate() + days); return d.toISOString().slice(0, 10); };\nconst tasks = [\n  { task_key: 'DOCUMENTS', title: 'Submit employment documents', description: 'Submit identity, education, and previous-employment documents.', owner_role: 'candidate', due_date: due(-3) },\n  { task_key: 'IT_ACCOUNT', title: 'Create company accounts', description: 'Create company email and required system accounts.', owner_role: 'admin', due_date: due(-2) },\n  { task_key: 'EQUIPMENT', title: 'Prepare work equipment', description: 'Allocate laptop and required accessories.', owner_role: 'admin', due_date: due(-1) },\n  { task_key: 'ORIENTATION', title: 'Attend employee orientation', description: 'Complete the NovaTech employee orientation session.', owner_role: 'candidate', due_date: due(0) },\n  { task_key: 'POLICY_ACK', title: 'Acknowledge company policies', description: 'Review and acknowledge company policies.', owner_role: 'candidate', due_date: due(2) }\n];\nreturn tasks.map(task => ({ json: { employee_id: employee.employee_id, ...task, status: 'PENDING' } }));"
      },
