    {
      "parameters": {
        "jsCode": "const approvals = $input.all().map(item => item.json);\nconst request = $('Validate Approval Decision').first().json;\nconst allApproved = approvals.length > 0 && approvals.every(row => row.status === 'APPROVED');\nconst pendingLevels = approvals.filter(row => row.status === 'PENDING').map(row => row.approval_level);\nreturn [{ json: { ...request, approval_count: approvals.length, all_approved: allApproved, pending_levels: pendingLevels } }];"
      },
