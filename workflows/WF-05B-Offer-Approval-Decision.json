    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst offerId = String(body.offer_id || '').trim();\nconst approvalLevel = Number(body.approval_level);\nconst decision = String(body.decision || '').trim().toUpperCase();\nconst approverId = String(body.approver_id || '').trim();\nconst comments = String(body.comments || '').trim();\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst errors = [];\nif (!uuidPattern.test(offerId)) errors.push('A valid offer_id is required');\nif (![1, 2].includes(approvalLevel)) errors.push('approval_level must be 1 or 2');\nif (!['APPROVED', 'REJECTED'].includes(decision)) errors.push('decision must be APPROVED or REJECTED');\nif (!uuidPattern.test(approverId)) errors.push('A valid approver_id is required');\nif (decision === 'REJECTED' && !comments) errors.push('comments are required when rejecting an offer');\nreturn [{ json: { offer_id: offerId, approval_level: approvalLevel, decision, approver_id: approverId, comments: comments || null, decided_at: new Date().toISOString(), request_valid: errors.length === 0, validation_errors: errors } }];"
