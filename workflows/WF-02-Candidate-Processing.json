    {
      "parameters": {
        "jsCode": "const input = $json;\nconst eventId = String(input.event_id || `APPLICATION_EVENT_${Date.now()}`);\nconst correlationId = String(input.correlation_id || `COR-${new Date().toISOString().slice(0,10).replaceAll('-','')}-${Date.now()}`);\nconst email = String(input.email || '').trim().toLowerCase();\nconst phone = String(input.phone || '').trim();\nconst normalizedEmail = email;\nconst normalizedPhone = phone.replace(/[^0-9+]/g, '');\nconst candidateCode = `CAN-${new Date().getUTCFullYear()}-${Math.abs([...normalizedEmail].reduce((a,c) => a + c.charCodeAt(0), 0)).toString().slice(-6)}`;\nconst applicationCode = `APP-${new Date().getUTCFullYear()}-${eventId.replace(/[^a-zA-Z0-9]/g, '').slice(-10)}`;\nconst positionIds = {\"Python Developer\":\"45cb1750-ee09-4fad-9a23-21701bf0e422\",\"Business Development Executive\":\"2834258a-6d99-43ee-b54a-79aa3fe2ffeb\",\"QA Engineer\":\"0ce9d819-1bbd-474e-b06a-5817b246803c\"}; input.job_position_id = positionIds[input.position];\nreturn [{ json: { ...input, event_id: eventId, correlation_id: correlationId, normalized_email: normalizedEmail, normalized_phone: normalizedPhone, candidate_code: candidateCode, application_code: applicationCode, processing_status: 'READY_FOR_PERSISTENCE' } }];"
      },
