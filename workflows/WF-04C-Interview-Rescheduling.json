      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst token = String(body.confirmation_token || '').trim();\nconst start = new Date(body.scheduled_start || '');\nconst end = body.scheduled_end ? new Date(body.scheduled_end) : new Date(start.getTime() + 60 * 60 * 1000);\nconst errors = [];\nif (!token) errors.push('confirmation_token is required');\nif (Number.isNaN(start.getTime())) errors.push('scheduled_start must be a valid ISO date');\nif (!Number.isNaN(start.getTime()) && start.getTime() <= Date.now()) errors.push('scheduled_start must be in the future');\nif (!Number.isNaN(start.getTime()) && !Number.isNaN(end.getTime()) && end <= start) errors.push('scheduled_end must be after scheduled_start');\nreturn [{ json: { confirmation_token: token, scheduled_start: Number.isNaN(start.getTime()) ? null : start.toISOString(), scheduled_end: Number.isNaN(end.getTime()) ? null : end.toISOString(), meeting_url: body.meeting_url || null, request_valid: errors.length === 0, validation_errors: errors } }];"
      },
