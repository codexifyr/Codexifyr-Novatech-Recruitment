    {
      "parameters": {
        "jsCode": "const updated = $json;\nconst source = $('Prepare Reschedule Update').first().json;\nreturn [{ json: { success: true, interview_id: updated.id || source.id, interview_code: updated.interview_code || source.interview_code, application_id: updated.application_id || source.application_id, scheduled_start: updated.scheduled_start || source.new_scheduled_start, scheduled_end: updated.scheduled_end || source.new_scheduled_end, meeting_url: updated.meeting_url || source.new_meeting_url, interview_status: 'PENDING_CONFIRMATION', display_status: 'Interview Rescheduled - Confirmation Pending', message: 'The interview has been rescheduled. Please confirm the new time.' } }];"
